# Configurações de API / Server URL
OLLAMA_URL=http://ecoa-llm.duckdns.org:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_LOCAL_URL=http://localhost:11434/v1
OLLAMA_LOCAL_API_KEY=ollama
OLLAMA_LOCAL_EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m
# Alternativa local (defesa contra indisponibilidade do endpoint da turma):
# llama-server em 127.0.0.1:18321 com o GGUF do Qwen3-Embedding-0.6B
# (scripts/models.ps1 baixa e imprime o comando):
#   EMBEDDING_PROVIDER=ollama
#   OLLAMA_LOCAL_URL=http://127.0.0.1:18321/v1
#   OLLAMA_LOCAL_EMBEDDING_MODEL=Qwen3-Embedding-0.6B.Q8_0

# Modelos
GENERATION_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M
EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m
# Pausa (s) entre lotes de embedding no endpoint compartilhado (src/direct_build.py).
PAUSA_ENTRE_LOTES_EMBEDDING=0.5
# Provedor dos embeddings de CONSULTA (src/retrieve.py): ecoa (padrão,
# compartilhado), ollama (llama.cpp/Ollama local), openai ou custom. Só muda
# quem embeda a PERGUNTA; os vetores dos documentos são os do índice e não são
# reembedados por causa disso. O cache de query separa por endpoint e modelo.
EMBEDDING_PROVIDER=ecoa
# Rede da consulta: falha rápida e cooldown por endpoint/modelo; sem trocar encoder.
QUERY_EMBEDDING_TIMEOUT=8
QUERY_EMBEDDING_COOLDOWN=30
# false = contingência BM25, sem modificar corpus ou índices (com aviso na resposta).
DENSE_RETRIEVAL_ENABLED=true
# Conferir na origem valores >= limiar; não corrige nem exclui os registros.
VALUE_REVIEW_THRESHOLD=1000000000
# Outro modelo de embedding exige reindexação ou comprovação de compatibilidade
# de checkpoint, instrução, pooling e vetores; dimensão igual não basta.

# Orçamento do contexto na geração. Janela curta (endpoint da turma, 2048
# tokens): 3500. OpenRouter (janela grande): 12000, para o top-k inteiro caber.
# Sem esta variável, o padrão acompanha o LLM_PROVIDER_MODE.
# GENERATION_CONTEXT_CHARS=12000
GENERATION_CHUNK_CHARS=900
# Tempo máximo (s) de cada chamada de geração e novas tentativas.
# Para a demo (ECOA principal, OpenRouter de reserva com OPENROUTER_API_KEY):
# GENERATION_TIMEOUT=60 e GENERATION_MAX_RETRIES=0. Medido em 2026-10-14: com
# 180 s e 1 nova tentativa, uma consulta esperou até 400 s; com 60 s e 0, as
# consultas lentas ficaram entre 69 e 101 s (a geração passou ao OpenRouter).
# Cada etapa que usa o LLM (reformulação, geração) paga a sua espera de 60 s.
GENERATION_TIMEOUT=180
GENERATION_MAX_RETRIES=1
# Temperatura da geração e da análise (respostas em JSON). 0 reduz a variação do
# texto entre execuções; o exemplo de llm_ecoa.py continua com 0,2.
LLM_TEMPERATURE=0
# none = o Qwen3 do ECOA responde sem raciocinar antes. Medido em 2026-10-16:
# uma pergunta curta caiu de 15 s para 2 s; nos 9 casos do golden set que
# passam pelo LLM, 201 s contra 262 s. Vazio = padrão do servidor.
# GENERATION_REASONING_EFFORT=none
# true = a resposta que sai do SQL é redigida pelo LLM (só a apresentação;
# números e fontes continuam do SQL). Medido em 2026-10-19: as consultas ao
# vivo iam de ~2,5 s para 7-25 s e passavam a depender do ECOA.
# SQL_APRESENTACAO_LLM=false
# Ler os índices (~150 MB) quando a API sobe, e não na primeira pergunta.
# INDEX_PRELOAD=true

# Rerank por cross-encoder local (src/rerank.py). Na primeira vez o modelo
# (~470 MB) é baixado para o cache do Hugging Face. false = só RRF.
RERANK_ENABLED=true
# local = cross-encoder local (padrão, melhor na ablação de 07/10);
# ecoa = endpoint /api/rerank da turma (cai no cross-encoder local se falhar).
RERANK_PROVIDER=local
# Vazio = derivado de OLLAMA_URL (http://ecoa-llm.duckdns.org:11434/api/rerank).
RERANK_URL=
RERANK_TIMEOUT=30
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=10
# Variedade na busca: máximo de trechos da mesma compra (ata) à frente dos
# candidatos do rerank; o excedente vai para o fim da lista. 0 = desligado.
RETRIEVAL_MAX_PER_PURCHASE=2
RERANK_MAX_LENGTH=512
# Carrega o cross-encoder quando a API sobe, em segundo plano, e não na primeira
# pergunta (~15 s; 69 s se ainda precisar baixar). false = carrega na primeira.
RERANK_PRELOAD=true

# Presets opcionais de APIs OpenAI-compatible
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_EMBEDDING_MODEL=xagi/qwen3-embedding:0.6b-q4_k_m

# Coleta e armazenamento
REQUEST_TIMEOUT=30
REQUEST_ATTEMPTS=3

# OCR de PDFs escaneados (Tesseract). Vazio = procura no PATH e em
# C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANG=por
OCR_DPI=300

# Base estruturada em SQL (src/structured_db.py). Vazio = SQLite local em
# data/structured/. Para usar Postgres (ex.: Neon), cole a connection string
# do painel do Neon, no formato:
# DATABASE_URL=postgresql://USUARIO:SENHA@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# API HTTP (app/api.py): origens extras liberadas no CORS, separadas por vírgula.
# localhost:5173 e 127.0.0.1:5173 (Vite) já são permitidas por padrão.
CORS_ALLOW_ORIGINS=https://etuarda.github.io
# Chave administrativa do histórico e dos traces (header X-API-Key); sem ela,
# só o dono da sessão via X-Session-Id.
# Gere uma com: python -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
# true = histórico geral (perguntas de todos) aberto sem chave, para a demo.
HISTORY_PUBLIC=false
# false = sem /docs, /redoc e /openapi.json (recomendado com o túnel público).
API_DOCS=true
# Limite por cliente, em requisições por minuto (0 desliga). Atrás do túnel, o
# IP real vem do X-Forwarded-For. Perguntas e feedback; leitura (histórico,
# trace, explorar).
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=120
# Cadeia de hashes no log (python -m src.log_chain verificar). Com a chave,
# HMAC-SHA256: gere uma com o mesmo comando da RAG_API_KEY e não a versione.
LOG_CHAIN_ENABLED=true
LOG_CHAIN_KEY=
# Dias que o histórico guarda cada consulta; 0 = sem expurgo.
HISTORY_RETENTION_DAYS=30
# Manifesto de um bundle imutável de runtime, conferido por GET /ready
# (src/snapshot.py). Vazio: /ready responde "manifesto_nao_configurado";
# o site usa /health e não depende dele.
SNAPSHOT_MANIFEST=
# Logs do pipeline: dias de retenção (0 = sem expurgo); sem esta variável,
# acompanha HISTORY_RETENTION_DAYS. A limpeza ocorre na primeira escrita diária.
LOG_RETENTION_DAYS=30
# resumo = candidatos/SQL compactos (padrão); completo = todas as evidências
# retornadas, resultado SQL e prompt mascarados, sem mudar o orçamento do LLM.
# Reinicie a aplicação após mudar. O modo completo ocupa mais espaço em disco.
LOG_EVIDENCE_DETAIL=resumo
# Relatórios de manutenção e temporários de testes falhos; limpeza explícita:
# python -m src.log_maintenance cleanup --apply
MAINTENANCE_RETENTION_DAYS=14

# Análise experimental por LLM: habilitar explicitamente após avaliar qualidade.
# O padrão preserva o analisador por regras; respostas continuam usando ECOA.
QUERY_ANALYSIS_MODE=regras
MODEL_MIN_INTERVAL_SECONDS=10

# ECOA principal + fallback OpenRouter. Chave somente no .env local.
OPENROUTER_API_KEY=
OPENROUTER_MAX_TOKENS=4096
# Prazo total de cada chamada ao OpenRouter (s); o timeout do SDK não corta
# respostas lentas, porque o OpenRouter manda sinais de processamento.
OPENROUTER_TIMEOUT=60
# auto = ECOA com fallback; openrouter = somente OpenRouter para LLM.
# O modo não troca o modelo/endpoint dos embeddings das perguntas.
LLM_PROVIDER_MODE=auto
# Modelo preferido das chamadas OpenRouter e reserva quando ele estiver
# indisponível (rede/timeout/404/408/429/5xx). Erros de entrada não trocam de
# modelo. Sem configurar, o padrão mantém "openrouter/free" nos dois.
# "openrouter/free" sorteia o modelo gratuito a cada chamada (em 2026-10-14 vieram
# 6 modelos em 9 chamadas, inclusive um classificador de segurança que não gera
# resposta) e às vezes não acha modelo que aceite JSON (404). Fixar um modelo
# gratuito com saída JSON deixa a resposta estável; medido em 2026-10-14, as
# consultas do roteiro levaram de 3 a 41 s (contra 68 a 330 s no ECOA):
#   OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
#   OPENROUTER_MODEL_FALLBACK=minimax/minimax-m3.1-flash:free
# (até 2026-10-20: nemotron-3-super-120b-a12b e gemma-4-31b-it; o primeiro passou
# a devolver 404 e o segundo, limite de uso no provedor). Modelos gratuitos
# mudam e falham sem aviso: confira em https://openrouter.ai/models antes de usar.
OPENROUTER_MODEL=
OPENROUTER_MODEL_FALLBACK=
# Identificação de mensagens longas/comuns: llm ou regras (só cortesia direta).
CONVERSATION_MODE=llm
# Reescrita de perguntas de continuação ("os mesmos contratos", "E em 2024?") com o
# historico enviado pelo cliente: llm ou regras (desliga; o historico e' ignorado).
REFORMULACAO_MODE=llm
# Prazo próprio da reformulação, em segundos; o fallback seguro anexa o contexto se
# a etapa demorar ou falhar. 91% das reescritas do ECOA cabem em 60 s.
REFORMULACAO_TIMEOUT=60
